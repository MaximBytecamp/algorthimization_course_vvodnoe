<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0b1020">
  <title>Основы алгоритмизации и программирования · 3 курс</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Pixelify+Sans:wght@500;600;700&family=Roboto+Mono:wght@400;500;700&family=Unbounded:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="boot" id="boot">
    <div class="boot__scanlines" aria-hidden="true"></div>
    <div class="boot-card">
      <div class="boot-card__top"><span>ОП.04 · 3 КУРС</span><span>2026 / 2027</span></div>
      <p class="boot-card__title">Основы алгоритмизации<br><em>и программирования</em></p>
      <dl class="boot-card__fields">
        <div><dt>Формат</dt><dd>вопрос → разбор → практика</dd></div>
        <div><dt>Объём</dt><dd>154 часа · 77 занятий</dd></div>
        <div><dt>Практика</dt><dd>около 82% содержательной части</dd></div>
        <div><dt>Результат</dt><dd>interview-prep portfolio v1.0</dd></div>
      </dl>
    </div>
    <p class="boot__hint">нажмите любую клавишу, чтобы начать <i>▸</i></p>
  </div>

  <div class="deck" id="deck" aria-live="polite">
    <header class="chrome">
      <button class="brand" type="button" data-go="0" aria-label="На первый слайд">
        <span class="brand-mark">A<span>/</span>П</span>
        <span class="brand-copy">Основы алгоритмизации<br>и программирования</span>
      </button>
      <div class="chrome-right">
        <button class="icon-button" id="sourcesButton" type="button" aria-label="Открыть источники">S</button>
        <button class="icon-button" id="fullscreenButton" type="button" aria-label="Полноэкранный режим">⛶</button>
        <span class="counter"><span id="currentNumber">01</span><i>/</i><span id="totalNumber">31</span></span>
      </div>
    </header>

    <main class="slides">
      <!-- Вступительный слайд -->
      <section class="slide slide--title is-active" data-kind="title" data-accent="lime">
        <div class="slide-inner title-layout">
          <div>
            <p class="eyebrow">Новый учебный год · 3 курс · 2026/2027</p>
            <h1>Основы<br>алгоритмизации<br>и программирования</h1>
            <p class="lead">От задач, которые работают вокруг нас, — к алгоритмической секции уровня intern/junior.</p>
            <div class="title-meta"><span>154 часа</span><span>77 занятий</span><span>≈ 82% практики</span></div>
          </div>
          <figure class="meme-frame title-meme tilt-right">
            <img src="memes/meme-cat-two-laptops.jpg" alt="Кот одновременно работает за двумя ноутбуками">
          </figure>
        </div>
        <span class="pair-number">00</span>
      </section>

      <!-- Вступительная пара -->
      <section class="slide slide--question" data-kind="question" data-accent="orange">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Завтра · первая пара</p>
          <h1>Что начинается<br>завтра?</h1>
          <p class="question-hint">Первая точка нового учебного года</p>
        </div>
        <span class="pair-number">ВВ</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="orange">
        <div class="slide-inner split split--hero">
          <div>
            <p class="eyebrow">Новый учебный год · 3 курс</p>
            <h2>Год, в котором код придётся объяснять</h2>
            <p class="lead">Мы будем решать задачи, проверять решения, сравнивать подходы и учиться защищать выбор алгоритма.</p>
            <div class="stat-row">
              <div class="stat"><strong>154</strong><span>часа</span></div>
              <div class="stat"><strong>77</strong><span>занятий</span></div>
              <div class="stat"><strong>3</strong><span>курс</span></div>
            </div>
          </div>
          <figure class="meme-frame meme-frame--wide tilt-right">
            <img src="memes/meme-wake-up-neo.jpg" alt="Лего-человек спит среди компьютеров, на экране надпись Wake up, Neo">
          </figure>
        </div>
        <span class="pair-number">ВВ</span>
      </section>

      <!-- 1 -->
      <section class="slide slide--question" data-kind="question" data-accent="pink">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 01 · алгоритмы вокруг нас</p>
          <h1>Где встречаются<br>алгоритмы?</h1>
          <p class="question-hint">До того, как мы открываем редактор кода</p>
        </div>
        <span class="pair-number">01</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="pink">
        <div class="slide-inner">
          <p class="eyebrow">Каждое цифровое действие начинается с правил обработки данных</p>
          <h2>Поиск, маршрут, лента, платёж, склад</h2>
          <div class="use-grid">
            <article><span class="use-icon">⌕</span><strong>Поиск</strong><p>Отобрать и упорядочить результаты.</p></article>
            <article><span class="use-icon">↗</span><strong>Маршрут</strong><p>Найти путь с учётом ограничений.</p></article>
            <article><span class="use-icon">≋</span><strong>Лента</strong><p>Определить порядок событий.</p></article>
            <article><span class="use-icon">✓</span><strong>Платёж</strong><p>Проверить условия и обнаружить аномалию.</p></article>
            <article><span class="use-icon">⌁</span><strong>Склад</strong><p>Сократить число перемещений при сборке.</p></article>
            <article class="use-grid__meme"><img src="memes/meme-excel-world.jpg" alt="Мем о мировой финансовой системе, работающей на Excel"></article>
          </div>
          <div class="depth-strip">
            <div><b>Вход</b><span>запрос, координаты, события, заказ</span></div>
            <i>→</i><div><b>Правила</b><span>сравнение, поиск, сортировка, выбор</span></div>
            <i>→</i><div><b>Результат</b><span>ответ, маршрут, решение или действие</span></div>
          </div>
        </div>
        <span class="pair-number">01</span>
      </section>

      <!-- 2 -->
      <section class="slide slide--question" data-kind="question" data-accent="lime">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 02 · точное понятие</p>
          <h1>Что называется<br>алгоритмом?</h1>
          <p class="question-hint">Определение должно объяснять механизм</p>
        </div>
        <span class="pair-number">02</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="lime">
        <div class="slide-inner definition-layout">
          <p class="eyebrow">Определение</p>
          <blockquote>Алгоритм — конечная последовательность однозначных действий, которая преобразует входные данные в требуемый результат.</blockquote>
          <div class="pipeline" aria-label="Пример работы алгоритма">
            <div><small>вход</small><code>[7, 2, 9, 2]</code></div>
            <span>→</span>
            <div><small>действия</small><code>пройти · сравнить · сохранить</code></div>
            <span>→</span>
            <div><small>результат</small><code>max = 9</code></div>
          </div>
          <div class="definition-notes">
            <div><b>Конечность</b><span>выполнение завершается за определённое число шагов</span></div>
            <div><b>Однозначность</b><span>каждое действие интерпретируется одинаково</span></div>
            <div><b>Результативность</b><span>для допустимого входа получаем требуемый выход</span></div>
          </div>
          <figure class="meme-strip"><img src="memes/meme-can-turn-on-pc.jpg" alt="Мем с кнопкой включения компьютера"></figure>
        </div>
        <span class="pair-number">02</span>
      </section>

      <!-- 3 -->
      <section class="slide slide--question" data-kind="question" data-accent="blue">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 03 · готовые библиотеки</p>
          <h1>Зачем изучать их,<br>если существуют готовые функции?</h1>
          <p class="question-hint">Функция выполняет операцию, но не выбирает решение</p>
        </div>
        <span class="pair-number">03</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="blue">
        <div class="slide-inner split split--code">
          <div>
            <p class="eyebrow">Выбор под ограничения</p>
            <h2>Нужно понимать цену операции</h2>
            <div class="compare-list">
              <div><code>list</code><span>быстрый доступ по индексу</span></div>
              <div><code>set</code><span>быстрая проверка наличия</span></div>
              <div><code>heap</code><span>быстрый доступ к приоритету</span></div>
              <div><code>graph</code><span>связи и маршруты</span></div>
            </div>
            <div class="tradeoff-row"><span><b>время</b> сколько операций</span><span><b>память</b> сколько данных храним</span><span><b>корректность</b> какие случаи учтены</span></div>
            <p class="note">Одна и та же функция может быть подходящей для тысячи элементов и неприемлемой для миллиона.</p>
          </div>
          <div class="answer-visual-stack">
            <div class="terminal-card">
              <div class="terminal-top"><i></i><i></i><i></i><span>constraints.py</span></div>
              <pre><span class="dim"># n = 10</span>
O(n²)   <b class="ok">✓</b>

<span class="dim"># n = 1 000 000</span>
O(n²)   <b class="bad">TLE</b>
O(n)    <b class="ok">✓</b></pre>
            </div>
            <figure class="mini-meme"><img src="memes/meme-math-hyperspace.jpg" alt="Кот на фоне формул, мем о математическом гиперпространстве"></figure>
          </div>
        </div>
        <span class="pair-number">03</span>
      </section>

      <!-- 4 -->
      <section class="slide slide--question" data-kind="question" data-accent="orange">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 04 · программные системы</p>
          <h1>Где алгоритмы работают<br>внутри реальных программ?</h1>
          <p class="question-hint">Между пользовательским действием и ответом системы</p>
        </div>
        <span class="pair-number">04</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="orange">
        <div class="slide-inner">
          <p class="eyebrow">Типовые механизмы</p>
          <h2>Данные нужно найти, связать, упорядочить или сократить</h2>
          <div class="system-grid">
            <article><b>INDEX</b><strong>Поисковый индекс</strong><p>Структуры данных сокращают число просмотренных документов.</p></article>
            <article><b>CACHE</b><strong>Кэш</strong><p>Алгоритм решает, какие результаты хранить и какие вытеснять.</p></article>
            <article><b>QUEUE</b><strong>Очередь задач</strong><p>Приоритет определяет порядок обработки запросов.</p></article>
            <article><b>GRAPH</b><strong>Зависимости</strong><p>Граф показывает связи между пакетами, сервисами и этапами сборки.</p></article>
            <article><b>STREAM</b><strong>Поток событий</strong><p>Окно и счётчики находят закономерности без хранения всей истории.</p></article>
            <figure><img src="memes/meme-office-documents.jpg" alt="Котёнок работает с документами за двумя мониторами"></figure>
          </div>
          <p class="system-note">В реальном сервисе эти механизмы работают вместе: запрос попадает в очередь, ищет данные через индекс, читает кэш и обновляет связанные сущности.</p>
        </div>
        <span class="pair-number">04</span>
      </section>

      <!-- 5 -->
      <section class="slide slide--question" data-kind="question" data-accent="pink">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 05 · алгоритмическая секция</p>
          <h1>Что проверяют<br>на алгоритмическом собеседовании?</h1>
          <p class="question-hint">Готовый код — только часть результата</p>
        </div>
        <span class="pair-number">05</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="pink">
        <div class="slide-inner">
          <p class="eyebrow">Наблюдаемый процесс решения</p>
          <h2>Интервьюер видит восемь действий</h2>
          <ol class="process-line">
            <li><span>01</span>понять условие</li><li><span>02</span>задать вопросы</li><li><span>03</span>привести примеры</li><li><span>04</span>предложить brute force</li>
            <li><span>05</span>оптимизировать</li><li><span>06</span>написать код</li><li><span>07</span>проверить</li><li><span>08</span>объяснить</li>
          </ol>
          <div class="criteria-row"><span><b>15%</b> условие</span><span><b>25%</b> алгоритм</span><span><b>20%</b> код</span><span><b>15%</b> тесты</span><span><b>15%</b> сложность</span><span><b>10%</b> коммуникация</span></div>
          <div class="answer-bottom">
            <p>Поэтому курс тренирует воспроизводимый процесс работы с новой задачей, а не угадывание знакомого шаблона.</p>
            <img src="memes/meme-did-you-get-it.jpg" alt="Мем с котом: понял? да, но он не понял">
          </div>
        </div>
        <span class="pair-number">05</span>
      </section>

      <!-- 6 -->
      <section class="slide slide--question" data-kind="question" data-accent="lime">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 06 · основание программы</p>
          <h1>Как проводился<br>аудит рынка?</h1>
          <p class="question-hint">Сопоставлялись форматы, критерии и повторяющиеся темы</p>
        </div>
        <span class="pair-number">06</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="lime">
        <div class="slide-inner audit-layout">
          <div>
            <p class="eyebrow">Срез на 1 августа 2026 года</p>
            <h2>Я провёл большой аудит открытых материалов рынка</h2>
            <p class="lead">Сравнил интервью-гайды, публичные контесты, разборы задач и образовательные материалы. В программу вошли темы, которые повторяются в требованиях к intern/junior.</p>
            <p class="audit-note">Для каждого утверждения проверялись источник, дата, роль кандидата и уровень. Компания могла менять процесс, поэтому курс опирается на пересечение требований, а не на один сценарий найма.</p>
            <figure class="audit-meme"><img src="memes/meme-four-laptops.jpg" alt="Человек одновременно работает за четырьмя ноутбуками"></figure>
          </div>
          <div class="audit-stack">
            <div><b>01</b><span>Собрать открытые источники</span></div>
            <div><b>02</b><span>Выделить критерии оценки</span></div>
            <div><b>03</b><span>Сопоставить структуры и техники</span></div>
            <div><b>04</b><span>Оставить пересекающееся ядро</span></div>
          </div>
        </div>
        <span class="pair-number">06</span>
      </section>

      <!-- 7 -->
      <section class="slide slide--question" data-kind="question" data-accent="orange">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 07 · рыночный ориентир</p>
          <h1>Какие компании<br>и площадки изучались?</h1>
          <p class="question-hint">Только открытые материалы с проверяемыми ссылками</p>
        </div>
        <span class="pair-number">07</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="orange">
        <div class="slide-inner">
          <p class="eyebrow">Компании и публичные форматы</p>
          <div class="company-grid company-grid--compact">
            <a href="https://yandex.ru/jobs/interview/algorithms/" target="_blank" rel="noreferrer" class="company-card"><img src="assets/logos/yandex.svg" alt="Яндекс"><p>Алгоритмическая секция, критерии и примеры задач.</p><span>официальный гайд ↗</span></a>
            <a href="https://www.tbank.ru/career/it/interview/backend/" target="_blank" rel="noreferrer" class="company-card"><img src="assets/logos/tbank.svg" alt="Т-Банк"><p>Структуры, алгоритмы, сложность и память.</p><span>официальный гайд ↗</span></a>
            <a href="https://habr.com/ru/companies/avito/articles/662922/" target="_blank" rel="noreferrer" class="company-card"><img src="assets/logos/avito.svg" alt="Avito"><p>Тайминг и объяснение решения.</p><span>AvitoTech ↗</span></a>
            <a href="https://habr.com/ru/companies/ozontech/articles/833762/" target="_blank" rel="noreferrer" class="company-card"><img src="assets/logos/ozon.svg" alt="Ozon"><p>Прикладные задачи отбора Route 256.</p><span>Ozon Tech ↗</span></a>
            <a href="https://digital.alfabank.ru/vacancies" target="_blank" rel="noreferrer" class="company-card company-card--muted"><img src="assets/logos/alfa.svg" alt="Альфа-Банк"><p>Карьерная среда — без неподтверждённых заявлений о формате секции.</p><span>Alfa Digital ↗</span></a>
          </div>
          <div class="platform-row"><span>CodeRun</span><span>Яндекс Контест</span><span>Route 256</span><span>LeetCode</span><span>HackerRank</span></div>
          <p class="disclaimer">Логотипы используются для учебного обзора и не означают партнёрство или одобрение курса.</p>
        </div>
        <span class="pair-number">07</span>
      </section>

      <!-- 8 -->
      <section class="slide slide--question" data-kind="question" data-accent="blue">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 08 · результат аудита</p>
          <h1>Какие темы составляют<br>общее ядро?</h1>
          <p class="question-hint">Повторяются классы решений, а не отдельные условия</p>
        </div>
        <span class="pair-number">08</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="blue">
        <div class="slide-inner">
          <p class="eyebrow">Обязательное ядро</p>
          <h2>Структуры + техники + объяснение</h2>
          <div class="topic-cloud">
            <span class="xl">массивы</span><span class="lg">строки</span><span>two pointers</span><span>sliding window</span><span>prefix sums</span>
            <span class="xl">hash map</span><span>set</span><span>stack</span><span>queue</span><span class="lg">сортировка</span>
            <span class="xl">binary search</span><span>heap</span><span class="lg">деревья</span><span class="lg">графы</span><span>DFS / BFS</span>
            <span>recursion</span><span>backtracking</span><span>greedy</span><span class="xl">динамическое программирование</span>
          </div>
          <div class="core-bands"><span><b>Структуры</b> как организованы данные</span><span><b>Техники</b> как сокращается перебор</span><span><b>Процесс</b> как доказать и проверить решение</span></div>
          <div class="topic-bottom"><p>Через все темы проходят O-нотация, тесты, dry run, code review и устное объяснение.</p><img src="memes/meme-binary-memes.jpg" alt="Мем: обычные мемы — 0, бинарные мемы — 1"></div>
        </div>
        <span class="pair-number">08</span>
      </section>

      <!-- 9 -->
      <section class="slide slide--question" data-kind="question" data-accent="pink">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 09 · маршрут курса</p>
          <h1>Что конкретно<br>будем изучать?</h1>
          <p class="question-hint">Восемь разделов — от оценки эффективности до DP</p>
        </div>
        <span class="pair-number">09</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="pink">
        <div class="slide-inner">
          <p class="eyebrow">68 содержательных занятий</p>
          <div class="roadmap">
            <article><b>01</b><i>12 ч</i><strong>Эффективность</strong><span>интервью · Big O · замеры</span></article>
            <article><b>02</b><i>20 ч</i><strong>Массивы и строки</strong><span>указатели · окно · суммы</span></article>
            <article><b>03</b><i>20 ч</i><strong>Hash и линии</strong><span>map · set · stack · queue</span></article>
            <article><b>04</b><i>20 ч</i><strong>Поиск и порядок</strong><span>sort · binary search · heap</span></article>
            <article><b>05</b><i>16 ч</i><strong>Деревья</strong><span>DFS · BFS · BST · пути</span></article>
            <article><b>06</b><i>16 ч</i><strong>Графы</strong><span>связность · пути · DAG</span></article>
            <article><b>07</b><i>20 ч</i><strong>Выбор решения</strong><span>recursion · greedy · DP</span></article>
            <article><b>08</b><i>12 ч</i><strong>Интервью-практика</strong><span>contest · review · portfolio</span></article>
          </div>
          <figure class="roadmap-meme"><img src="memes/meme-pragramist.jpg" alt="Мем про программиста за несколькими мониторами"></figure>
        </div>
        <span class="pair-number">09</span>
      </section>

      <!-- 10 -->
      <section class="slide slide--question" data-kind="question" data-accent="lime">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 10 · рабочий процесс</p>
          <h1>Как задача превращается<br>в принятое решение?</h1>
          <p class="question-hint">Код появляется не на первом шаге</p>
        </div>
        <span class="pair-number">10</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="lime">
        <div class="slide-inner">
          <p class="eyebrow">Interview canvas</p>
          <div class="canvas-flow">
            <div><b>1</b><strong>Условие</strong><span>пересказать своими словами</span></div><i>→</i>
            <div><b>2</b><strong>Уточнения</strong><span>границы и формат входа</span></div><i>→</i>
            <div><b>3</b><strong>Примеры</strong><span>обычные и крайние случаи</span></div><i>→</i>
            <div><b>4</b><strong>Brute force</strong><span>получить корректную основу</span></div><i>→</i>
            <div><b>5</b><strong>Оптимизация</strong><span>выбрать структуру и инвариант</span></div><i>→</i>
            <div><b>6</b><strong>Код и проверка</strong><span>dry run · тесты · сложность</span></div>
          </div>
          <div class="acceptance-strip"><b>Решение принято, если оно</b><span>корректно</span><span>укладывается в ограничения</span><span>проверено на границах</span><span>объяснено</span></div>
          <div class="meme-corner"><img src="memes/meme-engineers-meeting.jpg" alt="Коты в касках над чертежом, мем о совещании инженеров"></div>
        </div>
        <span class="pair-number">10</span>
      </section>

      <!-- 11 -->
      <section class="slide slide--question" data-kind="question" data-accent="orange">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 11 · 90 минут</p>
          <h1>Как проходит<br>занятие?</h1>
          <p class="question-hint">Основная часть времени остаётся студенту</p>
        </div>
        <span class="pair-number">11</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="orange">
        <div class="slide-inner">
          <p class="eyebrow">Ритм пары</p>
          <div class="timeline">
            <article style="--size:28"><span>15–30 мин</span><strong>Короткое объяснение</strong><p>Новая структура, инвариант и один разобранный пример.</p></article>
            <article style="--size:48"><span>40–55 мин</span><strong>Самостоятельное решение</strong><p>Уточнения, подход, код, тесты и оценка сложности.</p></article>
            <article style="--size:24"><span>10–20 мин</span><strong>Review и защита</strong><p>Dry run, сравнение вариантов и фиксация результата в Git.</p></article>
          </div>
          <div class="git-strip"><span>Issue</span><i>→</i><span>branch</span><i>→</i><span>commit</span><i>→</i><span>Pull Request</span><i>→</i><span>review</span></div>
          <p class="lesson-policy">ИИ разрешён после собственной попытки для review и тестов. На диагностике, mock-интервью, контестах и экзамене внешняя помощь запрещена.</p>
          <figure class="meme-inline"><img src="memes/meme-deep-dive.jpg" alt="Хорёк погружается головой в миску, мем о погружении в задачу"></figure>
        </div>
        <span class="pair-number">11</span>
      </section>

      <!-- 12 -->
      <section class="slide slide--question" data-kind="question" data-accent="blue">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 12 · практика</p>
          <h1>Какие инженерные ситуации<br>используются в задачах?</h1>
          <p class="question-hint">Алгоритм сохраняется, легенда показывает его назначение</p>
        </div>
        <span class="pair-number">12</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="blue">
        <div class="slide-inner">
          <p class="eyebrow">Алгоритмы с рабочим контекстом</p>
          <h2>Задачи строятся вокруг данных и ограничений</h2>
          <div class="scenario-grid">
            <span>логи</span><span>заказы</span><span>маршруты</span><span>очереди</span>
            <span>расписания</span><span>кэш</span><span>поиск</span><span>дедупликация</span>
            <span>зависимости</span><span>потоки данных</span>
            <figure><img src="memes/meme-tech-support.jpg" alt="Котята внутри системного блока, мем о технической поддержке"></figure>
          </div>
          <div class="scenario-example"><b>Одна техника — разные легенды</b><span><code>hash map</code>: индекс клиента, частоты событий, дедупликация заказов</span><span><code>graph</code>: маршрут, зависимости пакетов, порядок учебных модулей</span></div>
        </div>
        <span class="pair-number">12</span>
      </section>

      <!-- 13 -->
      <section class="slide slide--question" data-kind="question" data-accent="pink">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 13 · контроль результата</p>
          <h1>Как проверяется готовность<br>к собеседованию?</h1>
          <p class="question-hint">По наблюдаемым действиям, а не по ощущению</p>
        </div>
        <span class="pair-number">13</span>
      </section>

      <section class="slide slide--answer" data-kind="answer" data-accent="pink">
        <div class="slide-inner split">
          <div>
            <p class="eyebrow">Шесть репетиций интервью</p>
            <h2>Каждый mock оставляет отчёт</h2>
            <div class="mock-grid">
              <div><b>01</b><span>массивы<br>и строки</span></div><div><b>02</b><span>hash · list<br>stack · queue</span></div><div><b>03</b><span>sort · search<br>heap</span></div>
              <div><b>04</b><span>деревья</span></div><div><b>05</b><span>графы</span></div><div><b>06</b><span>greedy<br>и DP</span></div>
            </div>
            <div class="readiness-strip"><span><b>60 минут</b> держит темп</span><span><b>1 задача</b> решена полностью</span><span><b>2 задача</b> есть обоснованный прогресс</span><span><b>без IDE</b> код остаётся читаемым</span></div>
            <p class="note">Дополнительно: контест, code review, оптимизация решения и полная индивидуальная секция.</p>
          </div>
          <figure class="meme-frame tilt-left"><img src="memes/meme-know-nothing.jpg" alt="Собаки в позе лотоса, мем о том, что ничего не знаешь"></figure>
        </div>
        <span class="pair-number">13</span>
      </section>

      <!-- 14 -->
      <section class="slide slide--question" data-kind="question" data-accent="lime">
        <div class="slide-inner question-layout">
          <p class="eyebrow">Вопрос 14 · итог</p>
          <h1>С каким результатом<br>заканчивается курс?</h1>
          <p class="question-hint">Не только оценка в журнале</p>
        </div>
        <span class="pair-number">14</span>
      </section>

      <section class="slide slide--answer slide--final" data-kind="answer" data-accent="lime">
        <div class="slide-inner final-course-layout">
          <div>
            <p class="eyebrow">Interview-prep portfolio v1.0</p>
            <h2>Репозиторий<br>и подтверждённый процесс решения</h2>
            <div class="final-metrics"><span><strong>35+</strong> решений</span><span><strong>6</strong> mock-интервью</span><span><strong>3</strong> этапа экзамена</span></div>
            <div class="portfolio-strip"><span>tests</span><span>complexity notes</span><span>benchmarks</span><span>разбор ошибок</span><span>roadmap</span></div>
            <p class="lead">В финале: контест, live coding, code review и улучшение решения. Цель — самостоятельно пройти алгоритмическую секцию уровня intern/junior и понимать следующий шаг подготовки.</p>
            <button class="source-link" id="finalSourcesButton" type="button">Источники и материалы →</button>
          </div>
          <figure class="meme-frame tilt-right"><img src="memes/meme-exam-session.jpg" alt="Коты поддерживают друг друга перед сессией"></figure>
        </div>
        <span class="pair-number">14</span>
      </section>
    </main>

    <footer class="controls">
      <button class="nav-button" id="prevButton" type="button" aria-label="Предыдущий слайд">←</button>
      <div class="progress" id="progress" aria-hidden="true"></div>
      <button class="nav-button" id="nextButton" type="button" aria-label="Следующий слайд">→</button>
      <span class="key-hint">← → / пробел</span>
    </footer>
  </div>

