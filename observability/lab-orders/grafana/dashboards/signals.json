 },
 "timezone": "browser",
 "editable": false,
 "panels": [
  {
   "id": 1,
   "title": "HTTP · запросов в секунду",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-orders"
   },
   "description": "Технический сигнал rate. Приём заказов идёт, даже когда очередь не справляется.",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(orders_http_requests_total[1m]))",
     "legendFormat": "HTTP {{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "none"
    }
   }
  },
  {
   "id": 2,
   "title": "HTTP · p95 длительности ответа",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-orders"
